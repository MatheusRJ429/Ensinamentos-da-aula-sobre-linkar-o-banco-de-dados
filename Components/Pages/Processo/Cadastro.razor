@page "/processos/cadastro"
@rendermode InteractiveServer

@using Seila.Model

@inject ProcessoDAO dao
@inject NavigationManager NavigationManager

<PageTitle>Novo Processo - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Processo</h2>
        <p class="text-muted mb-0">Preencha os dados do novo processo.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <EditForm Model="@processo" OnValidSubmit="@Salvar">
            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger mb-3" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Número</label>

                    <InputText class="form-control"
                               @bind-Value="processo.Numero" />

                    <ValidationMessage For="@(() => processo.Numero)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Data</label>

                    <InputDate class="form-control"
                               @bind-Value="processo.Data" />

                    <ValidationMessage For="@(() => processo.Data)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Situação</label>

                    <InputSelect class="form-select"
                                 @bind-Value="processo.Situacao">

                        <option value="Aberto">Aberto</option>
                        <option value="Em análise">Em análise</option>
                        <option value="Pendente">Pendente</option>
                        <option value="Concluído">Concluído</option>
                        <option value="Arquivado">Arquivado</option>

                    </InputSelect>

                    <ValidationMessage For="@(() => processo.Situacao)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Interessado</label>

                    <InputText class="form-control"
                               @bind-Value="processo.Interessado" />

                    <ValidationMessage For="@(() => processo.Interessado)" />
                </div>

                <div class="col-12">
                    <label class="form-label">Assunto</label>

                    <InputText class="form-control"
                               @bind-Value="processo.Assunto" />

                    <ValidationMessage For="@(() => processo.Assunto)" />
                </div>

                <div class="col-12">
                    <label class="form-label">Descrição</label>

                    <InputTextArea class="form-control"
                                   rows="5"
                                   @bind-Value="processo.Descricao" />

                    <ValidationMessage For="@(() => processo.Descricao)" />
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Salvar
                </button>

                <a href="/processos" class="btn btn-secondary">
                    Cancelar
                </a>

            </div>

        </EditForm>

    </div>
</div>

@code {
    private Processo processo = new();

    private void Salvar()
    {
        dao.Inserir(processo);

        NavigationManager.NavigateTo("/processos");
    }
}