@page "/processos/cadastro"
@page "/processos/editar/{Id:int}"
@rendermode InteractiveServer

@using Seila.Model
@using Microsoft.AspNetCore.Components

@inject ProcessoDAO dao
@inject NavigationManager NavigationManager

<PageTitle>@Titulo - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@Titulo</h2>
        <p class="text-muted mb-0">
            @(Id.HasValue
                ? "Altere os dados do processo."
                : "Preencha os dados do novo processo.")
        </p>
    </div>
</div>

@if (Id.HasValue && !processoEncontrado)
{
    <div class="alert alert-warning" role="alert">
        Processo não encontrado.
        <a href="/processos" class="alert-link">Voltar para a lista</a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <EditForm Model="@processo" OnValidSubmit="@Salvar">
                <DataAnnotationsValidator />

                <ValidationSummary class="text-danger mb-3" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Número</label>

                        <InputText class="form-control"
                                   @bind-Value="processo.Numero" />

                        <ValidationMessage For="@(() => processo.Numero)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Data</label>

                        <InputDate class="form-control"
                                   @bind-Value="processo.Data" />

                        <ValidationMessage For="@(() => processo.Data)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Situação</label>

                        <InputSelect class="form-select"
                                     @bind-Value="processo.Situacao">

                            <option value="Aberto">Aberto</option>
                            <option value="Em análise">Em análise</option>
                            <option value="Pendente">Pendente</option>
                            <option value="Concluído">Concluído</option>
                            <option value="Arquivado">Arquivado</option>

                        </InputSelect>

                        <ValidationMessage For="@(() => processo.Situacao)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Interessado</label>

                        <InputText class="form-control"
                                   @bind-Value="processo.Interessado" />

                        <ValidationMessage For="@(() => processo.Interessado)" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Assunto</label>

                        <InputText class="form-control"
                                   @bind-Value="processo.Assunto" />

                        <ValidationMessage For="@(() => processo.Assunto)" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descrição</label>

                        <InputTextArea class="form-control"
                                       rows="5"
                                       @bind-Value="processo.Descricao" />

                        <ValidationMessage For="@(() => processo.Descricao)" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        @(Id.HasValue ? "Atualizar" : "Salvar")
                    </button>

                    <a href="/processos" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    private Processo processo = new();
    private bool processoEncontrado = true;

    [Parameter]
    public int? Id { get; set; }

    private string Titulo =>
        Id.HasValue ? "Editar Processo" : "Cadastro de Processo";

    protected override void OnParametersSet()
    {
        if (!Id.HasValue)
        {
            processo = new Processo();
            processoEncontrado = true;
            return;
        }

        var processoCarregado = dao.ObterPorId(Id.Value);

        processoEncontrado = processoCarregado is not null;

        if (processoCarregado is not null)
        {
            processo = processoCarregado;
        }
    }

    private void Salvar()
    {
        if (Id.HasValue)
        {
            dao.Atualizar(processo);
        }
        else
        {
            dao.Inserir(processo);
        }

        NavigationManager.NavigateTo("/processos");
    }
}
